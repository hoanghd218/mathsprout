# ============================================================
# MathSprout — Environment Variables
# ============================================================
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# `.env.local` đã có trong .gitignore — sẽ KHÔNG bị commit lên Git.
#
#   cp .env.example .env.local
#
# ============================================================

# ------------------------------------------------------------
# OpenRouter API Key (cho AI Assistant Sprout)
# ------------------------------------------------------------
# Lấy key tại: https://openrouter.ai/keys
# Model mặc định: moonshotai/kimi-k2.6 (Moonshot AI Kimi K2.6)
#
# ⚠️  KHÔNG có tiền tố VITE_ → key CHỈ dùng phía server
#    (Vercel Serverless Function), KHÔNG bao giờ lộ ra client.
#
# Local dev:
#   1) npm install
#   2) Chạy: npm run dev
#      → Vite + middleware /api/* tự đọc env và proxy tới OpenRouter
#
# Production (Vercel deploy):
#   Vào dashboard Vercel → Settings → Environment Variables
#   → thêm OPENROUTER_API_KEY với cùng giá trị → redeploy
# ------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ------------------------------------------------------------
# (Tuỳ chọn) Override model — mặc định moonshotai/kimi-k2.6
# Tham khảo danh sách model: https://openrouter.ai/models
# ------------------------------------------------------------
# OPENROUTER_MODEL=moonshotai/kimi-k2.6

# ------------------------------------------------------------
# (Tuỳ chọn) Headers attribution gửi tới OpenRouter
# ------------------------------------------------------------
# OPENROUTER_SITE_URL=https://mathsprout.app
# OPENROUTER_APP_TITLE=MathSprout
